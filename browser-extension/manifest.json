{
  "manifest_version": 3,
  "name": "Meeting Transcription for Google Meet",
  "version": "1.0.0",
  "description": "Real-time transcription and AI-powered summaries for Google Meet meetings",
  
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "scripting",
    "downloads"
  ],
  
  "host_permissions": [
    "https://meet.google.com/*",
    "https://calendar.google.com/*",
    "https://www.googleapis.com/*",
    "https://www.googleapis.com/drive/*",
    "https://www.googleapis.com/upload/drive/*"
  ],
  
  "background": {
    "service_worker": "background/background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "content-scripts/meet-detector.js",
        "content-scripts/audio-capture.js",
        "content-scripts/ui-injection.js"
      ],
      "css": ["content-scripts/meet-styles.css"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Meeting Transcription"
  },
  
  "options_page": "options/options.html",
  
  "oauth2": {
    "client_id": "your-google-oauth-client-id.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["injected-scripts/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}