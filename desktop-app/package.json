{
  "name": "universal-meeting-transcription",
  "version": "1.0.0",
  "description": "Universal desktop application for meeting transcription across all platforms",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.meetingtranscription.desktop",
    "productName": "Meeting Transcription",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "your-org",
      "repo": "meeting-transcription"
    }
  },
  "dependencies": {
    "electron": "^27.0.0",
    "electron-updater": "^6.1.4",
    "electron-store": "^8.1.0",
    "node-record-lpcm16": "^1.0.1",
    "speaker": "^0.5.4",
    "screenshot-desktop": "^1.12.7",
    "jimp": "^0.22.10",
    "tesseract.js": "^4.1.1",
    "robotjs": "^0.6.0",
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3",
    "axios": "^1.6.0",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "electron-builder": "^24.6.4",
    "jest": "^29.7.0",
    "playwright": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.4"
  },
  "keywords": [
    "meeting",
    "transcription",
    "electron",
    "desktop",
    "universal"
  ],
  "author": "Meeting Transcription Team",
  "license": "MIT"
}