{
  "name": "teams-meeting-transcription",
  "version": "1.0.0",
  "description": "Microsoft Teams plugin for real-time meeting transcription with AI-powered summaries",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "test": "jest",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:performance": "jest --testPathPattern=performance",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "test:security": "jest --testPathPattern=security",
    "test:all": "node scripts/run-comprehensive-tests.js",
    "test:comprehensive": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance && npm run test:accessibility && npm run test:security",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:validate": "node scripts/validate-test-suite.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test:teams-integration": "node scripts/test-teams-integration.js",
    "package:teams": "npm run build && node scripts/package-teams-app.js",
    "package:teams:dev": "node scripts/package-teams-app.js",
    "generate:icons": "node scripts/generate-icons.js",
    "test:installation": "node scripts/test-installation.js",
    "test:cross-platform": "jest tests/integration/cross-platform-adapters.integration.test.js",
    "test:platform-errors": "jest tests/integration/platform-error-handling.integration.test.js",
    "test:multi-platform-e2e": "playwright test tests/e2e/multi-platform-workflow.spec.js",
    "test:multi-platform-performance": "jest tests/performance/multi-platform-audio.performance.test.js",
    "test:cross-platform-accessibility": "jest tests/accessibility/cross-platform-ui.accessibility.test.js",
    "test:cross-platform-security": "jest tests/security/cross-platform-data.security.test.js",
    "test:cross-platform-all": "npm run test:cross-platform && npm run test:platform-errors && npm run test:multi-platform-e2e && npm run test:multi-platform-performance && npm run test:cross-platform-accessibility && npm run test:cross-platform-security",
    "validate:package": "npm run package:teams:dev && npm run test:installation",
    "build:all-platforms": "node scripts/build-platforms.js all",
    "build:teams": "node scripts/build-platforms.js teams",
    "build:zoom": "node scripts/build-platforms.js zoom",
    "build:extension": "node scripts/build-platforms.js extension",
    "validate:all": "node scripts/deploy-validation.js",
    "validate:teams": "node scripts/deploy-validation.js teams",
    "validate:zoom": "node scripts/deploy-validation.js zoom",
    "validate:extension": "node scripts/deploy-validation.js extension",
    "test:deployment": "jest --testPathPattern=tests/deployment/",
    "deploy:staging": "npm run build:all-platforms && npm run validate:all",
    "deploy:production": "npm run test:all && npm run build:all-platforms && npm run validate:all"
  },
  "keywords": [
    "microsoft-teams",
    "transcription",
    "speech-to-text",
    "meeting",
    "ai-summary"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@microsoft/teams-js": "^2.19.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "archiver": "^6.0.1",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "jest-axe": "^8.0.0",
    "jest-html-reporters": "^3.1.5",
    "jest-junit": "^16.0.0",
    "jest-performance-testing": "^1.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "lighthouse": "^11.4.0",
    "nodemon": "^3.0.1",
    "playwright": "^1.40.0",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "supertest": "^6.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}