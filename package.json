{
  "name": "teams-meeting-transcription",
  "version": "1.0.0",
  "description": "Microsoft Teams plugin for real-time meeting transcription with AI-powered summaries",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test:integration": "node scripts/test-teams-integration.js",
    "package:teams": "npm run build && npm run create:teams-package",
    "create:teams-package": "mkdir -p teams-app-package && cp manifest.json teams-app-package/ && cp assets/*.png teams-app-package/ 2>/dev/null || echo 'Note: Add icon files to assets/ directory' && cd teams-app-package && zip -r ../teams-transcription-app.zip . && cd .. && echo 'Teams app package created: teams-transcription-app.zip'"
  },
  "keywords": [
    "microsoft-teams",
    "transcription",
    "speech-to-text",
    "meeting",
    "ai-summary"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@microsoft/teams-js": "^2.19.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/react-hooks": "^8.0.1",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@xenova/transformers)/)"
    ]
  }
}
