{
  "name": "Meeting Transcription Pro",
  "version": "1.0.0",
  "description": "Real-time meeting transcription with AI-powered summaries and speaker identification",
  "short_description": "AI-powered meeting transcription for Zoom",
  "category": "Productivity",
  "author": {
    "name": "Meeting Transcription Team",
    "email": "support@meetingtranscription.com"
  },
  "home_url": "https://meetingtranscription.com",
  "support_url": "https://meetingtranscription.com/support",
  "privacy_policy_url": "https://meetingtranscription.com/privacy",
  "terms_of_service_url": "https://meetingtranscription.com/terms",
  "scopes": [
    "meeting:read",
    "meeting:write", 
    "user:read",
    "chat_message:write",
    "recording:read",
    "webinar:read"
  ],
  "redirect_uris": [
    "https://meetingtranscription.com/oauth/zoom/callback",
    "http://localhost:3000/oauth/zoom/callback"
  ],
  "webhook_url": "https://meetingtranscription.com/webhooks/zoom",
  "event_subscriptions": [
    "meeting.started",
    "meeting.ended",
    "meeting.participant_joined",
    "meeting.participant_left",
    "meeting.sharing_started",
    "meeting.sharing_ended",
    "recording.completed"
  ],
  "features": {
    "in_meeting": true,
    "pre_meeting": true,
    "post_meeting": true,
    "chat_message": true,
    "recording_integration": true
  },
  "installation_note": "This app requires microphone permissions to provide real-time transcription during meetings.",
  "app_type": "oauth"
}